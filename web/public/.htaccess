# Site Dame de Tours (version Astro) — servi tel quel par Hostinger depuis la branche « deploy ».
# Adresses propres : /atelier sert atelier.html ; /atelier.html redirige (301) vers /atelier.

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
# Dossier de déploiement Git (racine de l'hébergement) jamais servi
RedirectMatch 404 /\.git

<IfModule mod_rewrite.c>
  RewriteEngine On

  # À la racine de l'hébergement (damedetours.com), le dossier preprod/ est celui du sous-domaine de test :
  # jamais servi sur le domaine principal (pas de doublon du site pour Google)
  # (Règle lue aussi depuis le .htaccess du dossier preprod/ lui-même : test sur l'adresse complète.)
  RewriteCond %{HTTP_HOST} !^preprod\. [NC]
  RewriteCond %{REQUEST_URI} ^/preprod(/|$) [NC]
  RewriteRule ^ - [R=404,L]

  # Toujours en HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → domaine sans www (l'adresse canonique est https://damedetours.com)
  RewriteCond %{HTTP_HOST} ^www\.damedetours\.com(:[0-9]+)?$ [NC]
  RewriteRule ^ https://damedetours.com%{REQUEST_URI} [L,R=301,NE]

  # ── Anciennes adresses de la boutique Shopify (bascule de damedetours.com) ──
  # Inventaire du 17/11/2026 (sitemaps Shopify). Un « ? » final retire les paramètres
  # (?variant=…, ?page=…) pour ne pas créer de doublons.

  # Paiement, commandes, liens d'e-mails Shopify → la boutique sur son sous-domaine
  # (302 : liens de service, pas de référencement ; les paramètres sont gardés)
  RewriteRule ^(checkouts?|cart/.+|[0-9]+/(orders|checkouts|invoices)|apps|tools|services)(/.*)?$ https://boutique.damedetours.com%{REQUEST_URI} [R=302,L,NE]
  RewriteRule ^(account|customer_authentication)(/.*)?$ https://profil.damedetours.com/profile [R=302,L]
  RewriteRule ^cart/?$ /? [R=301,L]

  # Fiches produit (aussi sous /collections/…/products/…, et .json/.js/.atom)
  RewriteRule ^(?:collections/[^/]+/)?products/jeux-echecs-dame-de-tours-ancolie-(blanc|noir|la-chute-des-anges)(?:\.[a-z]+)?/?$ /ancolie-$1? [R=301,L]
  # Créations du personnaliseur (lien du produit dans le paiement Shopify) : leur récapitulatif
  RewriteRule ^(?:collections/[^/]+/)?products/ddt-creation-([a-f0-9-]{36})/?$ https://personnalisation-jeu-echecs.damedetours.com/creation-recap.html?id=$1 [R=302,L]
  RewriteRule ^(?:collections/[^/]+/)?products(/.*)?$ /collection-ancolie? [R=301,L]

  # Collections
  RewriteRule ^collections/variantes?-dancolie-blanc/?$ /ancolie-blanc? [R=301,L]
  RewriteRule ^collections/variantes?-dancolie-noir/?$ /ancolie-noir? [R=301,L]
  RewriteRule ^collections/(variantes?-dancolie-ange|editions-ephemeres)/?$ /ancolie-la-chute-des-anges? [R=301,L]
  RewriteRule ^collections(/.*)?$ /collection-ancolie? [R=301,L]

  # Pages
  RewriteRule ^pages/jeux-dechecs/?$ /collection-ancolie? [R=301,L]
  RewriteRule ^pages/(personnalisation|professionnels)/?$ /personnalisation? [R=301,L]
  RewriteRule ^pages/atelier/?$ /atelier? [R=301,L]
  RewriteRule ^pages/ouverture/?$ /ouverture? [R=301,L]
  RewriteRule ^pages/(contact|support|faq)/?$ /contact? [R=301,L]
  RewriteRule ^pages(/.*)?$ /? [R=301,L]

  # Blog (vide) et pages légales
  RewriteRule ^blogs(/.*)?$ /actualites? [R=301,L]
  RewriteRule ^policies/privacy-policy/?$ /confidentialite? [R=301,L]
  RewriteRule ^policies/contact-information/?$ /coordonnees? [R=301,L]
  RewriteRule ^policies/legal-notice/?$ /mentions-legales? [R=301,L]
  RewriteRule ^policies/refund-policy/?$ /remboursements? [R=301,L]
  RewriteRule ^policies/shipping-policy/?$ /livraison? [R=301,L]
  RewriteRule ^policies/terms-of-sale/?$ /conditions-generales-de-vente? [R=301,L]
  RewriteRule ^policies/terms-of-service/?$ /conditions-utilisation? [R=301,L]
  RewriteRule ^policies(/.*)?$ /mentions-legales? [R=301,L]

  # Plans du site et recherche Shopify
  RewriteRule ^sitemap_[^/]*\.xml$ /sitemap.xml? [R=301,L]
  RewriteRule ^search/?$ /? [R=301,L]

  # Adresse de test (preprod.) : masquée à Google
  RewriteCond %{HTTP_HOST} ^preprod\. [NC]
  RewriteRule ^ - [E=DDT_PREPROD:1]
  RewriteCond %{HTTP_HOST} ^preprod\. [NC]
  RewriteRule ^robots\.txt$ /robots-preprod.txt [L]

  # Ancien chemin /site/… (premier déploiement)
  RewriteCond %{THE_REQUEST} \s/site/(\S*?)(?:\.html)?[\s?]
  RewriteRule ^ /%1 [R=301,L]
  # Anciennes adresses en .html (et /index) → adresse propre
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?index(?:\.html)?[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # Espace d'écriture Sanity (/studio) : application d'une seule page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^studio(/.*)?$ /studio/index.html [L]

  # Barre oblique finale → sans (aucun dossier n'est navigable)
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /atelier → atelier.html (le fichier existe)
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=DDT_PREPROD
  Header set X-Robots-Tag "noindex, nofollow" env=REDIRECT_DDT_PREPROD
  # Fichiers versionnés (?v=empreinte) et images : cache long. Pages HTML : toujours revérifiées.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType model/gltf-binary "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript image/svg+xml
</IfModule>
